{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Institutional Identity Card (SD-JWT)",
  "description": "IETF SD-JWT Verifiable Credential schema for an institutional identity card, adhering to India DPDP Act 2023. PII is redacted off-chain.",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "description": "Issuer DID (e.g., did:web:gov.in:dept)",
      "example": "did:web:gov.in:identity_dept"
    },
    "sub": {
      "type": "string",
      "description": "Holder DID (e.g., did:ethr:amoy:0x...)",
      "example": "did:ethr:amoy:0x1234567890abcdef"
    },
    "vct": {
      "type": "string",
      "description": "Verifiable Credential Type",
      "const": "InstitutionalIdCredential"
    },
    "iat": {
      "type": "integer",
      "description": "Issuance timestamp (UNIX epoch)"
    },
    "exp": {
      "type": "integer",
      "description": "Expiry timestamp (UNIX epoch)"
    },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "role_designation": {
          "type": "string",
          "description": "Institutional role or designation"
        },
        "aadhaar_reference": {
          "type": "string",
          "description": "Strictly redacted placeholder for Aadhaar to comply with DPDP Act 2023",
          "const": "[Aadhaar Redacted]"
        },
        "department": {
          "type": "string"
        }
      },
      "required": ["role_designation", "aadhaar_reference"]
    },
    "_sd": {
      "type": "array",
      "description": "Array of strings representing selectively disclosable claims",
      "items": {
        "type": "string"
      }
    },
    "_sd_alg": {
      "type": "string",
      "const": "sha-256"
    }
  },
  "required": ["iss", "sub", "vct", "iat", "credentialSubject"]
}
