# Backend (PowerShell: set these as $env:NAME; .env is not loaded automatically)
VAULT_MODE=local
VAULT_RPC_URL=http://127.0.0.1:8545
VAULT_MANIFEST=deployments/31337.json
VAULT_DATABASE_URL=sqlite:///vault-local.db
VAULT_AUDIENCE=http://127.0.0.1:3000
VAULT_PHYSICAL_ENABLED=false
# Production adapter: postgresql+psycopg://USER:PASSWORD@HOST/DB
# PRIVATE_KEY is required only for an explicitly requested non-local deployment.
# Never put a private key, NFC key, service token or database password in VITE_*.
